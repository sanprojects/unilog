{
  "key_segments": {
    "passwords": ["password", "passwd", "pwd", "passphrase", "secret", "client_secret"],
    "tokens": ["token", "access_token", "refresh_token", "id_token", "api_key", "apikey", "apitoken", "private_key", "secret_key", "signature", "sig", "credentials", "auth"],
    "http": ["authorization", "proxy_authorization", "cookie", "set_cookie", "x_api_key", "x_auth_token", "x_csrf_token"],
    "sessions": ["session", "sessionid", "sid", "jsessionid", "phpsessid", "csrf", "xsrf"],
    "payment": ["card", "cardnumber", "pan", "cvv", "cvc", "cvv2", "card_cvc", "expiry", "exp_month", "exp_year", "iban", "account_number", "routing_number"],
    "documents": ["ssn", "passport", "tin", "inn", "snils", "dob", "birthdate"],
    "mfa": ["otp", "totp", "pin", "mfa_code", "recovery_code"]
  },
  "pii_profile_key_segments": {
    "contact": ["email", "phone", "ip", "user_id", "name"]
  },
  "value_patterns": [
    { "name": "jwt", "regex": "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\b", "prefilter": "eyJ" },
    { "name": "bearer", "regex": "(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{10,}", "prefilter": "bearer" },
    { "name": "pan", "regex": "\\b(?:\\d[ -]*?){13,19}\\b", "prefilter": null, "note": "Luhn-checked after match; non-PAN digit runs are left alone" },
    { "name": "pem", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----", "prefilter": "PRIVATE KEY" },
    { "name": "aws_access_key", "regex": "\\b(AKIA|ASIA)[A-Z0-9]{16}\\b", "prefilter": null },
    { "name": "github_token", "regex": "\\b(ghp_|gho_|ghu_|ghs_|glpat-)[A-Za-z0-9_-]{20,}\\b", "prefilter": null },
    { "name": "dsn", "regex": "\\b[a-z][a-z0-9+.-]*://[^\\s:/@]+:[^\\s:/@]+@[^\\s/]+", "prefilter": "://" },
    { "name": "kv_secret", "regex": "(?i)\\b(password|passwd|token|secret|api[_-]?key)\\s*[=:]\\s*[^\\s,;&]{4,}", "prefilter": null }
  ],
  "replacement": {
    "mask": "[REDACTED]",
    "drop": null
  }
}
