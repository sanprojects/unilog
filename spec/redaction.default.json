{
  "key_segments": {
    "passwords": [
      "password",
      "passwd",
      "pwd",
      "passphrase",
      "secret",
      "client_secret"
    ],
    "tokens": [
      "token",
      "access_token",
      "refresh_token",
      "id_token",
      "api_key",
      "apikey",
      "apitoken",
      "private_key",
      "secret_key",
      "signature",
      "sig",
      "credentials",
      "auth"
    ],
    "http": [
      "authorization",
      "proxy_authorization",
      "cookie",
      "set_cookie",
      "x_api_key",
      "x_auth_token",
      "x_csrf_token"
    ],
    "sessions": [
      "session",
      "sessionid",
      "sid",
      "jsessionid",
      "phpsessid",
      "csrf",
      "xsrf"
    ],
    "payment": [
      "card",
      "cardnumber",
      "pan",
      "cvv",
      "cvc",
      "cvv2",
      "card_cvc",
      "expiry",
      "exp_month",
      "exp_year",
      "iban",
      "account_number",
      "routing_number"
    ],
    "documents": [
      "ssn",
      "passport",
      "tin",
      "inn",
      "snils",
      "dob",
      "birthdate"
    ],
    "mfa": [
      "otp",
      "totp",
      "pin",
      "mfa_code",
      "recovery_code"
    ]
  },
  "pii_profile_key_segments": {
    "contact": [
      "email",
      "phone",
      "ip",
      "user_id",
      "name"
    ]
  },
  "value_patterns": [
    {
      "name": "query_param",
      "regex": "(?i)([?&](?:key|api[_-]?key|access[_-]?key|token|access[_-]?token|auth|password|passwd|secret|client[_-]?secret|sig|signature|session|sid)=)([^&\\s\"'<>]{4,})",
      "prefilter": [
        "="
      ],
      "replace_group": 2,
      "note": "prefilter '=' only; masks group 2 so the parameter name survives"
    },
    {
      "name": "jwt",
      "regex": "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\b",
      "prefilter": [
        "eyJ"
      ]
    },
    {
      "name": "bearer",
      "regex": "(?i)\\bbearer\\s+[A-Za-z0-9._~+/=-]{10,}",
      "prefilter": [
        "bearer"
      ]
    },
    {
      "name": "pan",
      "regex": "\\b(?:\\d[ -]*?){13,19}\\b",
      "prefilter": null,
      "note": "Luhn-checked after match; non-PAN digit runs are left alone"
    },
    {
      "name": "pem",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "prefilter": [
        "PRIVATE KEY"
      ]
    },
    {
      "name": "aws_access_key",
      "regex": "\\b(AKIA|ASIA)[A-Z0-9]{16}\\b",
      "prefilter": [
        "AKIA",
        "ASIA"
      ]
    },
    {
      "name": "github_token",
      "regex": "\\b(ghp_|gho_|ghu_|ghs_)[A-Za-z0-9_-]{20,}\\b",
      "prefilter": [
        "gh"
      ]
    },
    {
      "name": "gitlab_token",
      "regex": "\\bglpat-[A-Za-z0-9_-]{20,}\\b",
      "prefilter": [
        "glpat-"
      ]
    },
    {
      "name": "google_api_key",
      "regex": "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "prefilter": [
        "AIza"
      ]
    },
    {
      "name": "google_oauth",
      "regex": "\\bya29\\.[0-9A-Za-z_-]{20,}",
      "prefilter": [
        "ya29."
      ]
    },
    {
      "name": "openai",
      "regex": "\\bsk-(proj-)?[A-Za-z0-9_-]{20,}\\b",
      "prefilter": [
        "sk-"
      ]
    },
    {
      "name": "stripe",
      "regex": "\\b(sk|rk|pk)_(live|test)_[A-Za-z0-9]{16,}\\b",
      "prefilter": [
        "_live_",
        "_test_"
      ]
    },
    {
      "name": "slack_token",
      "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
      "prefilter": [
        "xox"
      ]
    },
    {
      "name": "telegram_bot_token",
      "regex": "\\b\\d{8,10}:AA[A-Za-z0-9_-]{32,}\\b",
      "prefilter": [
        ":AA"
      ]
    },
    {
      "name": "sendgrid",
      "regex": "\\bSG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}\\b",
      "prefilter": [
        "SG."
      ]
    },
    {
      "name": "twilio_sid",
      "regex": "\\bAC[0-9a-f]{32}\\b",
      "prefilter": [
        "AC"
      ]
    },
    {
      "name": "npm_token",
      "regex": "\\bnpm_[A-Za-z0-9]{36}\\b",
      "prefilter": [
        "npm_"
      ]
    },
    {
      "name": "digitalocean_token",
      "regex": "\\bdop_v1_[0-9a-f]{64}\\b",
      "prefilter": [
        "dop_v1_"
      ]
    },
    {
      "name": "dsn",
      "regex": "\\b[a-z][a-z0-9+.-]*://[^\\s:/@]+:[^\\s:/@]+@[^\\s/]+",
      "prefilter": [
        "://"
      ]
    },
    {
      "name": "kv_secret",
      "regex": "(?i)\\b(password|passwd|token|secret|api[_-]?key)\\s*[=:]\\s*[^\\s,;&]{4,}",
      "prefilter": [
        "=",
        ":"
      ]
    }
  ],
  "replacement": {
    "mask": "[REDACTED]",
    "drop": null,
    "no_double_mask": "a match that already contains the mask is left alone, so a later, broader pattern cannot swallow `token=[REDACTED]` into a bare [REDACTED] and lose the parameter name. Implemented in the replacement callback, not as a lookahead - Go's RE2 has none."
  }
}
